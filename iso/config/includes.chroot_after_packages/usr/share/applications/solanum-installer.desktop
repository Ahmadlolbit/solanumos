[Desktop Entry]
Type=Application
Name=Install SolanumOS
Comment=Install SolanumOS on this computer's disk
Exec=kitty --class solanum-installer -e sudo --preserve-env=HYPRLAND_INSTANCE_SIGNATURE,XDG_RUNTIME_DIR /opt/solanum/build/bin/solanum-installer
Icon=system-software-install
Terminal=false
Categories=System;
