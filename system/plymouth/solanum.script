Window.SetBackgroundTopColor({{ BACKGROUND }});
Window.SetBackgroundBottomColor({{ BACKGROUND }});

step = 1;
size = 4;
prompt_font = "DejaVu Sans Mono 13";
bullet_font = "DejaVu Sans Mono 18";
message_font = "DejaVu Sans Mono 12";
if (Window.GetWidth() >= 2560 || Window.GetHeight() >= 1440) {
  step = 2;
  size = 8;
  prompt_font = "DejaVu Sans Mono 26";
  bullet_font = "DejaVu Sans Mono 36";
  message_font = "DejaVu Sans Mono 24";
}
logo = Image("burst-" + size + ".png");
logo_sprite = Sprite(logo);
logo_sprite.SetPosition(Window.GetWidth() / 2 - logo.GetWidth() / 2, Window.GetHeight() / 2 - logo.GetHeight(), 1);
below = Window.GetHeight() / 2;

frames = {{ FRAMES }};
{{ HOLDS }}
for (i = 0; i < frames; i++)
  shot[i] = Image("burst-" + size + "-" + i + ".png");
frame = {{ MARK }};
left = hold[frame];
asking = 0;

fun refresh() {
  if (!global.asking) {
    global.left = global.left - 1;
    if (global.left <= 0) {
      global.frame = global.frame + 1;
      if (global.frame >= frames)
        global.frame = 0;
      global.left = hold[global.frame];
      logo_sprite.SetImage(shot[global.frame]);
    }
  }
}

custom = "{{ BOOT_PROMPT }}";
prompt_sprite = Sprite();
bullet_sprite = Sprite();
hint_sprite = Sprite();
message_sprite = Sprite();

fun centre(sprite, image, y) {
  sprite.SetImage(image);
  sprite.SetPosition(Window.GetWidth() / 2 - image.GetWidth() / 2, y, 2);
  sprite.SetOpacity(1);
}

fun asks_pin(text) {
  for (i = 0; i < 200; i++)
    if (text.SubString(i, i + 3) == "PIN")
      return 1;
  return 0;
}

fun display_password(prompt, bullets) {
  global.asking = 1;
  global.frame = {{ MARK }};
  global.left = hold[global.frame];
  logo_sprite.SetImage(logo);
  dots = "";
  for (i = 0; i < bullets; i++)
    dots = dots + "• ";
  if (custom != "" && !asks_pin(prompt))
    prompt = custom;
  if (prompt == "")
    prompt = "Password";
  centre(prompt_sprite, Image.Text(prompt, {{ FOREGROUND }}, 1, prompt_font), below + 60 * step);
  centre(bullet_sprite, Image.Text(dots + "_", {{ ACCENT }}, 1, bullet_font), below + 100 * step);
  centre(hint_sprite, Image.Text("Type it, then press Enter", {{ MUTED }}, 1, message_font), below + 140 * step);
}

fun display_normal() {
  global.asking = 0;
  prompt_sprite.SetOpacity(0);
  bullet_sprite.SetOpacity(0);
  hint_sprite.SetOpacity(0);
}

fun display_message(text) {
  centre(message_sprite, Image.Text(text, {{ FOREGROUND }}, 1, message_font), Window.GetHeight() - 80 * step);
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetMessageFunction(display_message);
