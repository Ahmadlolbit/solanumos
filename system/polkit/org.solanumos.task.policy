<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SolanumOS</vendor>
  <vendor_url>https://github.com/Ahmadlolbit/solanumos</vendor_url>
  <action id="org.solanumos.task.run">
    <description>Update, check or change this computer for everyone</description>
    <message>SolanumOS needs your password to update, check or change this computer for everyone</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">{{ HELPER }}</annotate>
  </action>
</policyconfig>
